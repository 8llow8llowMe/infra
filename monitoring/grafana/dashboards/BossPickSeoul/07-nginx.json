        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum(count_over_time({job=\"nginx\", project=\"$project\", env=\"$env\", site=~\"$site\"} | json | status >= 500 [$__range])) / sum(count_over_time({job=\"nginx\", project=\"$project\", env=\"$env\", site=~\"$site\"} [$__range])) or vector(0)",
          "legendFormat": "5xx",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
