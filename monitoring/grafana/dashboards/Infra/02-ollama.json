{
  "id": null,
  "uid": "infra-ollama",
  "title": "Infra Ollama",
  "description": "Ollama 는 Prometheus 메트릭을 내지 않으므로 GIN 요청 로그(Loki)로 요청량 · 지연 · 호출 호스트를, node_exporter drm collector 로 GPU 를 봅니다.",
  "tags": [
    "infra",
    "ollama",
    "loki",
    "gpu"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "infra"
      ],
      "title": "Infra 대시보드",
      "type": "dashboards",
      "targetBlank": false,
      "tooltip": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "path",
        "label": "경로",
        "type": "custom",
        "query": "/api/chat,/api/generate,/api/embed,/api/embeddings,/v1/chat/completions",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "요약",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "요청 수 (기간)",
      "description": "선택한 기간의 추론 요청 수. /api/ps · /api/tags · /metrics 같은 상태 조회는 뺐다.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(count_over_time({host=\"ollama-01\", container=\"ollama\"} |= \"[GIN]\" | regexp `\\|\\s*(?P<status>\\d{3})\\s*\\|\\s*(?P<latency>\\S+)\\s*\\|\\s*(?P<client>\\S+)\\s*\\|\\s*(?P<method>[A-Z]+)\\s+\"(?P<path>[^\"]+)\"` | path!~\"^(/api/(ps|tags|version)|/metrics|/)$\" | path=~\"^($path)$\" [$__range]))",
          "legendFormat": "요청",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 지연 (기간)",
      "description": "추론 요청 응답 시간 p95. gpt-oss:20b 는 수십 초가 정상 범위다.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {host=\"ollama-01\", container=\"ollama\"} |= \"[GIN]\" | regexp `\\|\\s*(?P<status>\\d{3})\\s*\\|\\s*(?P<latency>\\S+)\\s*\\|\\s*(?P<client>\\S+)\\s*\\|\\s*(?P<method>[A-Z]+)\\s+\"(?P<path>[^\"]+)\"` | path!~\"^(/api/(ps|tags|version)|/metrics|/)$\" | path=~\"^($path)$\" | unwrap duration(latency) | __error__=\"\" [$__range]) by (path)",
          "legendFormat": "{{path}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
