{
  "id": null,
  "uid": "__PROJECT__-jvm",
  "title": "__PROJECT_TITLE__ JVM / 런타임 상세",
  "description": "Micrometer JVM 지표인 힙/Non-Heap 메모리, 프로세스·시스템 CPU, load average, 스레드, GC와 HikariCP 연결 풀을 서비스별로 확인합니다.",
  "tags": ["__PROJECT__", "backend", "jvm", "prometheus", "micrometer"],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 3,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "links": [
    {"asDropdown": true, "icon": "external link", "includeVars": true, "keepTime": true, "tags": ["__PROJECT__"], "title": "__PROJECT_TITLE__ 대시보드", "type": "dashboards", "targetBlank": false, "tooltip": ""}
  ],
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard"}]},
  "templating": {
    "list": [
      {"name": "project", "label": "프로젝트", "type": "constant", "query": "__PROJECT__", "hide": 2, "current": {"text": "__PROJECT__", "value": "__PROJECT__"}},
      {"name": "env", "label": "환경", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(jvm_info{project=\"$project\"}, env)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": false, "multi": false, "sort": 1, "current": {"selected": true, "text": "dev", "value": "dev"}},
      {"name": "service", "label": "서비스", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(jvm_info{project=\"$project\", env=\"$env\"}, service)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "sort": 1, "current": {"selected": true, "text": "All", "value": "$__all"}},
      {"name": "instance", "label": "인스턴스", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(jvm_info{project=\"$project\", env=\"$env\", service=~\"$service\"}, instance)", "refId": "VariableQuery"}, "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "sort": 1, "current": {"selected": true, "text": "All", "value": "$__all"}}
    ]
  },
  "panels": [
    {"id": 100, "type": "row", "title": "요약 ($env)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": []},
    {
      "id": 1, "type": "stat", "title": "프로세스 가동시간", "description": "서비스 JVM 프로세스가 마지막으로 시작된 이후의 경과 시간입니다.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "max by (service) (process_uptime_seconds{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "fixed", "fixedColor": "green"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "type": "stat", "title": "힙 메모리 사용률", "description": "서비스별 최대 힙 대비 현재 사용량입니다.", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service) (jvm_memory_used_bytes{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", area=\"heap\"}) / sum by (service) (jvm_memory_max_bytes{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", area=\"heap\"})", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.85}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3, "type": "stat", "title": "프로세스 CPU 사용률", "description": "각 JVM 프로세스의 CPU 사용률입니다.", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "max by (service) (process_cpu_usage{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4, "type": "stat", "title": "활성 스레드 수", "description": "현재 살아 있는 JVM 스레드 수입니다.", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "max by (service) (jvm_threads_live_threads{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "purple"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {"id": 101, "type": "row", "title": "메모리 / CPU", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6}, "panels": []},
    {
      "id": 5, "type": "timeseries", "title": "힙 메모리 사용량 / 최대값", "description": "서비스별 힙 사용량과 설정된 최대값을 비교합니다.", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "editorMode": "code", "expr": "sum by (service) (jvm_memory_used_bytes{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", area=\"heap\"})", "legendFormat": "{{service}} 사용"},
        {"refId": "B", "editorMode": "code", "expr": "sum by (service) (jvm_memory_max_bytes{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", area=\"heap\"})", "legendFormat": "{{service}} 최대"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity", "showPoints": "never", "axisSoftMin": 0}}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".* 최대"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}}, {"id": "custom.fillOpacity", "value": 0}]}]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 6, "type": "timeseries", "title": "프로세스 CPU 사용률 추이", "description": "서비스별 JVM 프로세스 CPU 사용률 변화입니다.", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "process_cpu_usage{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"}", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity", "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {"id": 102, "type": "row", "title": "스레드 / GC", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16}, "panels": []},
    {
      "id": 7, "type": "timeseries", "title": "스레드 상태", "description": "RUNNABLE, WAITING, BLOCKED 등 JVM 스레드 상태별 개수입니다.", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 17},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service, state) (jvm_threads_states_threads{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service}} {{state}}"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity", "showPoints": "never", "stacking": {"mode": "normal", "group": "A"}, "axisSoftMin": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 8, "type": "timeseries", "title": "GC 일시 정지 부담", "description": "초당 GC 일시 정지 시간의 합으로 GC 압력을 확인합니다.", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 17},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "sum by (service, action, cause) (rate(jvm_gc_pause_seconds_sum{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{service}} {{action}} {{cause}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity", "showPoints": "never", "axisSoftMin": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {"id": 103, "type": "row", "title": "DB 커넥션 풀", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26}, "panels": []},
    {
      "id": 9, "type": "timeseries", "title": "HikariCP 연결 풀 사용량", "description": "DB를 사용하는 서비스의 활성 연결과 최대 연결 수입니다. DB를 사용하지 않는 cloud 서비스에는 데이터가 없습니다.", "gridPos": {"h": 9, "w": 24, "x": 0, "y": 27},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "editorMode": "code", "expr": "sum by (service, pool) (hikaricp_connections_active{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service}} {{pool}} 활성"},
        {"refId": "B", "editorMode": "code", "expr": "sum by (service, pool) (hikaricp_connections_max{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service}} {{pool}} 최대"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity", "showPoints": "never", "axisSoftMin": 0}}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".* 최대"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}}, {"id": "custom.fillOpacity", "value": 0}]}]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {"id": 104, "type": "row", "title": "시스템 / Non-Heap", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36}, "panels": []},
    {
      "id": 10, "type": "timeseries", "title": "Non-Heap 메모리 (used / committed)", "description": "메타스페이스·코드 캐시 등 Non-Heap 영역의 사용량과 커밋량입니다.", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 37},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "editorMode": "code", "expr": "sum by (service) (jvm_memory_used_bytes{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", area=\"nonheap\"})", "legendFormat": "{{service}} 사용"},
        {"refId": "B", "editorMode": "code", "expr": "sum by (service) (jvm_memory_committed_bytes{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\", area=\"nonheap\"})", "legendFormat": "{{service}} 커밋"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity", "showPoints": "never", "axisSoftMin": 0}}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".* 커밋"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}}, {"id": "custom.fillOpacity", "value": 0}]}]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 11, "type": "timeseries", "title": "시스템 / 프로세스 CPU 사용률", "description": "호스트 전체(system)와 JVM 프로세스(process) CPU 사용률입니다. 프로세스가 낮은데 시스템이 높으면 같은 호스트의 다른 부하 영향입니다.", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 37},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "editorMode": "code", "expr": "max by (service) (process_cpu_usage{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service}} process"},
        {"refId": "B", "editorMode": "code", "expr": "max by (service) (system_cpu_usage{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service}} system"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "gradientMode": "opacity", "showPoints": "never"}}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".* system"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}}]}]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 12, "type": "timeseries", "title": "시스템 부하 (load average 1m)", "description": "OS 1분 load average입니다. JVM에서 가용 프로세서 수(system_cpu_count)를 넘으면 CPU 경합입니다.", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 46},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "editorMode": "code", "expr": "max by (service) (system_load_average_1m{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service}} load 1m"},
        {"refId": "B", "editorMode": "code", "expr": "max by (service) (system_cpu_count{project=\"$project\", env=\"$env\", service=~\"$service\", instance=~\"$instance\"})", "legendFormat": "{{service}} CPU 수"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "gradientMode": "opacity", "showPoints": "never", "axisSoftMin": 0}}, "overrides": [{"matcher": {"id": "byRegexp", "options": ".* CPU 수"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [8, 6]}}, {"id": "custom.fillOpacity", "value": 0}]}]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ]
}
