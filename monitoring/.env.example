# 모니터링 서버 공통 설정
TZ=Asia/Seoul

# 사용할 컨테이너 이미지
# Grafana는 12.4.0부터 grafana/grafana-oss 저장소가 중단되어 grafana/grafana(동일 OSS 이미지)로 이전합니다.
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1
GRAFANA_IMAGE=grafana/grafana:12.4.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
LOKI_IMAGE=grafana/loki:3.2.1
PROMTAIL_IMAGE=grafana/promtail:3.2.1

# 컨테이너 이름
PROMETHEUS_CONTAINER_NAME=prometheus
GRAFANA_CONTAINER_NAME=grafana
NODE_EXPORTER_CONTAINER_NAME=node-exporter
LOKI_CONTAINER_NAME=loki
PROMTAIL_CONTAINER_NAME=promtail

# 호스트에 노출할 포트
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
NODE_EXPORTER_PORT=9100
LOKI_PORT=3100

# 컨테이너 메모리 상한 (deploy 는 1.9Gi 호스트). 합계 1.6Gi 이고 swap 6Gi 가 받친다.
# 2026-10-12 실측 사용량: prometheus 52Mi, grafana 84Mi(11.3), loki 88Mi, promtail 160Mi, node-exporter 10Mi
PROMETHEUS_MEM_LIMIT=640m
GRAFANA_MEM_LIMIT=320m
LOKI_MEM_LIMIT=384m
PROMTAIL_MEM_LIMIT=192m
NODE_EXPORTER_MEM_LIMIT=64m

# 데이터 보관 기준
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=8GB
LOKI_RETENTION_PERIOD=72h

# 모니터링 서버 자신의 Docker 로그를 Loki로 전송할 때 사용하는 Promtail 설정
MONITORING_PROMTAIL_LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
MONITORING_PROMTAIL_HOSTNAME=deploy
MONITORING_PROMTAIL_PROJECT=infra

# Grafana 관리자 계정
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-password
