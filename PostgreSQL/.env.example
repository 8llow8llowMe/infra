# PostgreSQL 설정 템플릿. `cp .env.example .env` 후 값을 채운다(.env 는 커밋 금지).
# 실제 비밀번호는 Vault 에도 등록한다 — 슈퍼유저는 운영자 보관용, 프로젝트 계정은 각 프로젝트 KV 경로(DB_PASSWORD).

POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
# openssl rand -base64 32
POSTGRES_SUPERUSER_PASSWORD=

# main-server(RAM 7.8Gi, MySQL · dev 백엔드 동거) 기준값. 전용 서버면 늘린다.
POSTGRES_MEM_LIMIT=768m
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_EFFECTIVE_CACHE_SIZE=384MB
POSTGRES_MAX_CONNECTIONS=200
