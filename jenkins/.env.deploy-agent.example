# deploy agent 전용 env 예시입니다.
#
# controller / builder 값이 필요 없는 배포 대상 호스트(main-server, backend-1, prod 미니PC)에서 씁니다.
# `.env.example` 은 controller·builder·deploy 를 한 파일에 담고 있어 배포 호스트에서는
# 쓰지 않는 값이 절반이라, agent 하나당 이 파일을 복사해 쓰는 편이 낫습니다.
#
# 사용법:
#   cp .env.deploy-agent.example .env.frontend-dev
#   # 값을 채운 뒤
#   sh install-jenkins-agent.sh .env.frontend-dev
#
# agent 하나당 파일 하나입니다. 한 호스트에 여러 개를 둘 때는
# NAME / PROJECT_NAME / CONTAINER_NAME / WORKDIR 를 파일마다 다르게 둬야
# 컨테이너와 작업 디렉터리가 충돌하지 않습니다.
#
# 현재 배치 (jenkins/README.md 의 노드/라벨 표가 정본):
#   main-server(192.168.0.11) -> backend-dev-agent   (label: deploy-backend-dev)
#                             -> frontend-dev-agent  (label: deploy-frontend-dev)
#   backend-1(192.168.0.13)   -> backend-dev2-agent  (label: deploy-backend-dev2)   ※ 2026-10-01 prod -> dev 2
#   신규 미니PC(IP 미정)      -> backend-prod-agent  (label: deploy-backend-prod)
#                             -> frontend-prod-agent (label: deploy-frontend-prod)
#
# 라벨은 이 파일이 아니라 Jenkins UI 의 노드 설정에서 지정합니다.
#
# backend-1 의 backend-dev2-agent 는 이 파일을 .env.backend-dev2 로 복사해 아래 이름 4개만 바꾸면 됩니다.
# (JENKINS_URL / TZ / IMAGE 는 그대로, SECRET 은 노드 생성 후 발급값)
#   JENKINS_DEPLOY_AGENT_NAME=backend-dev2-agent
#   JENKINS_DEPLOY_AGENT_PROJECT_NAME=backend-dev2-agent
#   JENKINS_DEPLOY_AGENT_CONTAINER_NAME=backend-dev2-agent
#   JENKINS_DEPLOY_AGENT_WORKDIR=backend-dev2-agent

# controller 주소. 배포 호스트에서 사설망으로 접근 가능한 주소여야 합니다.
JENKINS_URL=http://192.168.0.10:49999
TZ=Asia/Seoul

# Jenkins UI 에서 만든 node 이름과 정확히 같아야 합니다.
# secret 이 node 이름으로 발급되므로 이름이 어긋나면 컨트롤러가 접속을 거부합니다.
JENKINS_DEPLOY_AGENT_NAME=frontend-dev-agent
# Jenkins UI 에서 node 생성 후 표시되는 값입니다. 직접 정하는 비밀번호가 아닙니다.
JENKINS_DEPLOY_AGENT_SECRET=change-me-after-node-created

# 같은 호스트의 다른 agent 와 겹치지 않게 둡니다.
JENKINS_DEPLOY_AGENT_PROJECT_NAME=frontend-dev-agent
JENKINS_DEPLOY_AGENT_CONTAINER_NAME=frontend-dev-agent
JENKINS_DEPLOY_AGENT_WORKDIR=frontend-dev-agent

JENKINS_DEPLOY_AGENT_IMAGE=jenkins-deploy-agent:latest
