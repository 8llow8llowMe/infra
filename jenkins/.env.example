# Jenkins controller 설정
JENKINS_WEB_PORT=49999
JENKINS_AGENT_PORT=50000
# 미니PC 사설 IP 또는 내부 DNS 이름으로 변경합니다.
JENKINS_URL=http://<ai-host-private-ip>:49999
JENKINS_CONTROLLER_JAVA_OPTS="-Xms256m -Xmx1536m -Duser.timezone=Asia/Seoul"
JENKINS_CONTROLLER_MEM_LIMIT=2560m
JENKINS_CONTROLLER_CPUS=2.0
JENKINS_OPTS=
JENKINS_CONTROLLER_PROJECT_NAME=jenkins-controller
JENKINS_CONTROLLER_IMAGE=jenkins-controller:latest
JENKINS_CONTROLLER_CONTAINER_NAME=jenkins-controller
JENKINS_CONTROLLER_HOME=./jenkins-home
TZ=Asia/Seoul

# 미니PC builder agent 설정
# Jenkins UI에서 같은 이름의 node를 만든 뒤 발급된 secret을 입력합니다.
JENKINS_BUILDER_NAME=ai-host-builder
JENKINS_BUILDER_SECRET=change-me-after-node-created
JENKINS_BUILDER_PROJECT_NAME=jenkins-builder-agent
JENKINS_BUILDER_IMAGE=jenkins-builder-agent:latest
JENKINS_BUILDER_CONTAINER_NAME=jenkins-builder-agent
JENKINS_BUILDER_WORKDIR=./jenkins-builder-agent
JENKINS_BUILDER_MEM_LIMIT=3g
JENKINS_BUILDER_CPUS=4.0
JENKINS_BUILDER_PIDS_LIMIT=1024
# Gradle 빌드의 동시 worker와 유휴 daemon을 줄여 20B API와 동거합니다.
JENKINS_BUILDER_GRADLE_OPTS="-Dorg.gradle.workers.max=2 -Dorg.gradle.daemon=false"

# 원격 deploy agent 설정 예시
# Jenkins UI에서 같은 이름의 node를 만든 뒤 발급된 secret을 입력합니다.
# deploy 서버에서 docker-compose-jenkins-deploy-agent.yml 실행 시 사용합니다.
#
# deploy agent 는 backend/frontend 로 나눠 둡니다.
#   main-server(192.168.0.11) -> backend-dev-agent   (label: deploy-backend-dev)
#                             -> frontend-dev-agent  (label: deploy-frontend-dev)
#   backend-1(192.168.0.13)   -> backend-prod-agent  (label: deploy-backend-prod)
#                             -> frontend-prod-agent (label: deploy-frontend-prod)
#
# 한 호스트에 둘 이상 두므로 env 파일을 나누고 install 스크립트에 인수로 넘깁니다.
#   sh install-jenkins-agent.sh .env.backend-dev
#   sh install-jenkins-agent.sh .env.frontend-dev
# 아래 4개(NAME/PROJECT_NAME/CONTAINER_NAME/WORKDIR)를 env 파일마다 다르게 둬야 충돌하지 않습니다.
# 라벨은 compose 가 아니라 Jenkins UI 의 노드 설정에서 지정합니다. (jenkins/README.md 참고)
JENKINS_DEPLOY_AGENT_NAME=backend-dev-agent
JENKINS_DEPLOY_AGENT_SECRET=change-me-after-node-created
JENKINS_DEPLOY_AGENT_PROJECT_NAME=backend-dev-agent
JENKINS_DEPLOY_AGENT_IMAGE=jenkins-deploy-agent:latest
JENKINS_DEPLOY_AGENT_CONTAINER_NAME=backend-dev-agent
JENKINS_DEPLOY_AGENT_WORKDIR=backend-dev-agent
