# Cloudflare DDNS (#59) — 실제 토큰은 여기에 쓰지 않고 ./secrets/cloudflare-api-token 파일에 둡니다.
DDNS_IMAGE=favonia/cloudflare-ddns:1.17.1
DDNS_CONTAINER_NAME=cloudflare-ddns
# 컨테이너 실행 uid:gid — 토큰 파일을 읽을 수 있어야 합니다(deploy 의 8llow8llowme = 1000:1003)
DDNS_UID=1000
DDNS_GID=1003
DDNS_MEM_LIMIT=64m
DDNS_CPUS=0.25
DDNS_UPDATE_CRON=@every 1m
DDNS_TTL=60
DDNS_RECORD_COMMENT=managed by Infra ddns (cloudflare-ddns)
TZ=Asia/Seoul

# 집 공인 IP 를 가리키는 A 레코드 전부(쉼표 구분). Cloudflare 로 네임서버를 옮긴 zone 의 이름만 넣습니다 —
# 아직 가비아에 있는 zone 의 이름을 넣으면 그 이름은 갱신되지 못하고 매 주기 오류 로그가 납니다. 목록 정본은 ddns/README.md 표.
DDNS_DOMAINS=8llow8llowme.com,www.8llow8llowme.com,jenkins.8llow8llowme.com,console.jenkins.8llow8llowme.com,grafana.8llow8llowme.com,kafka-ui.8llow8llowme.com,minio.8llow8llowme.com,console.minio.8llow8llowme.com,vault.8llow8llowme.com,ai.8llow8llowme.com
