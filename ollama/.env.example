# Ollama 기본 설정
# 운영 서버에서는 GPU/20B 회귀 테스트를 통과한 버전 태그로 고정합니다.
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_CONTAINER_NAME=ollama
OLLAMA_PORT=11434
OLLAMA_CONTAINER_PORT=11434
OLLAMA_HOST=0.0.0.0:11434
# 여러 프로젝트가 공유하는 gpt-oss:20b API의 콜드 스타트를 줄입니다.
OLLAMA_KEEP_ALIVE=5h
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# gpt-oss:20b API 기준. 다른 모델을 동시에 로드하지 않고 context를 4K로 제한합니다.
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_QUEUE=16
# OS MemTotal >= 29Gi일 때의 초기값. 더 작으면 HOST-STABILITY.md의 예산을 다시 계산합니다.
OLLAMA_MEM_LIMIT=17g
OLLAMA_CPUS=8.0
# flash attention + KV 캐시 8bit 양자화 (KV 캐시 메모리 절반, 긴 프롬프트에 유리)
# KV 캐시 양자화는 flash attention이 켜져 있어야 동작합니다.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_DATA_DIR=./ollama-data
OLLAMA_CONTAINER_DATA_DIR=/root/.ollama

# Open WebUI 설정
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OPEN_WEBUI_CONTAINER_NAME=open-webui
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_CONTAINER_PORT=8080
OPEN_WEBUI_MEM_LIMIT=1g
OPEN_WEBUI_OLLAMA_BASE_URL=http://ollama:11434
OPEN_WEBUI_DATA_DIR=./open-webui-data
OPEN_WEBUI_CONTAINER_DATA_DIR=/app/backend/data
WEBUI_SECRET_KEY=change-me-to-a-long-random-string

# AMD Vulkan iGPU 가속 설정 (Radeon 780M 등 AMD iGPU)
# OLLAMA_VULKAN=1 로 두면 베이스 이미지의 Vulkan 백엔드가 활성화됩니다.
OLLAMA_VULKAN=1
# Ollama 0.32+부터 내장 GPU는 기본 제외되므로 반드시 함께 켜야 합니다.
# 없으면 "dropping integrated GPU" 로그와 함께 CPU 추론으로 떨어집니다.
OLLAMA_IGPU_ENABLE=1
AMD_GPU_DRI_DEVICE=/dev/dri
# Ubuntu 22.04+ 에서는 /dev/dri/renderD128 이 render 그룹 소유입니다.
# 비워두면 install-ollama.sh 가 호스트에서 GID 를 자동 해석합니다.
AMD_GPU_RENDER_GROUP=

# 공통 설정
TZ=Asia/Seoul
